rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // OSIS-MPK SMAN 6 Bandung - Collection Rules
    match /users/{userId} {
      allow read, write: if true;
    }
    match /transactions/{transactionId} {
      allow read, write: if true;
    }
    match /notifications/{notificationId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
